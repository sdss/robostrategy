#!/usr/bin/env python
import argparse

from robostrategy.plan import fields_from_file, one_field_from_file

from sdssdb.peewee.sdss5db import database
database.set_profile('as5')

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Create fields from a YAML input file.")
    parser.add_argument("-i", "--input", type=str, help="Path to the input YAML file containing field definitions.")
    parser.add_argument("-o", "--one-field", action="store_true", help="Create only one field from the input YAML file.")
    parser.add_argument("--clobber", action="store_true", help="Overwrite existing cached target files.")
    args = parser.parse_args()

    if args.one_field:
        one_field_from_file(args.input, clobber=args.clobber)
    else:
        fields_from_file(args.input, clobber=args.clobber)
